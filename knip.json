{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/ts/boot.ts",
    "src/ts/gate.ts",
    "src/styles/index.scss",
    "project.config.js",
    "build/extract-changelog.js"
  ],
  "project": [
    "src/ts/**/*.ts",
    "!src/ts/photoswipe/**",
    "tests/**/*.ts",
    "src/styles/**/*.{scss,sass}",
    "build/**/*.js"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["composer", "fallow"],
  "ignoreDependencies": ["vue"]
}
