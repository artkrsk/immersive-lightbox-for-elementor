{
  "name": "@arts/immersive-lightbox",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "types": "./src/ts/index.ts",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev:plugin": "arts-wp dev",
    "build": "arts-wp build",
    "release": "arts-wp release",
    "test": "vitest run && vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:coverage": "vitest run --coverage && vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:php": "vendor/bin/phpunit --configuration phpunit.xml.dist"
  },
  "devDependencies": {
    "@artemsemkin/elementor-types": "^2.0.0",
    "@arts/wp-plugin-tooling": "github:artkrsk/wp-plugin-tooling",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.2",
    "fallow": "^3.15.0",
    "happy-dom": "20.14.5",
    "knip": "6.40.0",
    "lefthook": "^2.1.10",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "exports": {
    ".": "./src/ts/index.ts",
    "./contract": "./src/ts/contract/index.ts",
    "./package.json": "./package.json",
    "./src/ts/*": "./src/ts/*",
    "./src/styles/*": "./src/styles/*"
  }
}
