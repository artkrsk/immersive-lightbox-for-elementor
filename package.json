{
  "name": "@arts/immersive-lightbox",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "files": ["dist/esm", "dist/types", "src/ts", "src/styles", "composer.json", "DEVELOPERS.md", "LICENSE"],
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev:plugin": "arts-wp dev",
    "build": "arts-wp build",
    "build:library": "node scripts/build-library.mjs",
    "release": "arts-wp release",
    "test": "vitest run && vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:coverage": "vitest run --coverage && vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:php": "vendor/bin/phpunit --configuration phpunit.xml.dist"
  },
  "devDependencies": {
    "@artemsemkin/elementor-types": "^2.0.0",
    "@arts/wp-plugin-tooling": "github:artkrsk/wp-plugin-tooling",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.2",
    "fallow": "^3.15.0",
    "happy-dom": "20.14.5",
    "knip": "6.40.0",
    "lefthook": "^2.1.10",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "exports": {
    ".": {
      "arts-source": "./src/ts/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./contract": {
      "arts-source": "./src/ts/contract/index.ts",
      "types": "./dist/types/contract/index.d.ts",
      "import": "./dist/esm/contract.js",
      "default": "./dist/esm/contract.js"
    },
    "./gate": {
      "arts-source": "./src/ts/gate/index.ts",
      "types": "./dist/types/gate/index.d.ts",
      "import": "./dist/esm/gate.js",
      "default": "./dist/esm/gate.js"
    },
    "./styles.scss": "./src/styles/index.scss",
    "./styles.css": "./dist/esm/styles.css",
    "./package.json": "./package.json",
    "./src/ts/*": "./src/ts/*",
    "./src/styles/*": "./src/styles/*"
  }
}
