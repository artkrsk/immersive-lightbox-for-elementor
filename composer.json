{
  "name": "arts/immersive-lightbox",
  "description": "A PhotoSwipe lightbox that replaces Elementor's native one: cinematic transitions, mousemove explore pan, video galleries, any link as a trigger.",
  "version": "1.0.9",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Artem Semkin",
      "email": "me@artemsemkin.com",
      "homepage": "https://artemsemkin.com"
    }
  ],
  "homepage": "https://artemsemkin.com/plugins/immersive-lightbox-for-elementor/",
  "wordpress": {
    "Requires at least": "6.2",
    "Tested up to": "7.2",
    "Requires PHP": "8.0"
  },
  "plugin": {
    "Plugin Name": "Arts Immersive Lightbox for Elementor",
    "Plugin URI": "https://artemsemkin.com/plugins/immersive-lightbox-for-elementor/",
    "Description": "A PhotoSwipe lightbox that replaces Elementor's native one: cinematic transitions, mousemove explore pan, video galleries, any link as a trigger.",
    "Text Domain": "immersive-lightbox-for-elementor",
    "License": "GPLv3",
    "License URI": "https://www.gnu.org/licenses/gpl-3.0"
  },
  "require": {
    "php": ">=8.0",
    "arts/base": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "arts/elementor-stubs": "^4.0",
    "arts/wp-plugin-standards": "^1.0",
    "brianhenryie/strauss": "^0.32"
  },
  "autoload": {
    "classmap": [
      "vendor-prefixed/"
    ],
    "psr-4": {
      "Arts\\ImmersiveLightbox\\": "src/php/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "pre-autoload-dump": [
      "@php -r \"is_dir('vendor-prefixed') || mkdir('vendor-prefixed');\""
    ],
    "prefix-namespaces": [
      "@php vendor/bin/strauss",
      "@composer dump-autoload"
    ],
    "post-install-cmd": [
      "@php -r \"if (file_exists('vendor/bin/strauss')) { passthru(PHP_BINARY . ' vendor/bin/strauss', \\$code); if (\\$code) { exit(\\$code); } passthru('composer dump-autoload', \\$code); exit(\\$code); }\""
    ],
    "post-update-cmd": [
      "@php -r \"if (file_exists('vendor/bin/strauss')) { passthru(PHP_BINARY . ' vendor/bin/strauss', \\$code); if (\\$code) { exit(\\$code); } passthru('composer dump-autoload', \\$code); exit(\\$code); }\""
    ]
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "ArtsImmersiveLightbox\\",
      "classmap_prefix": "ArtsImmersiveLightbox_",
      "constant_prefix": "ARTS_IMMERSIVE_LIGHTBOX_VENDOR_",
      "classmap_output": true,
      "include_modified_date": true,
      "include_author": true,
      "packages": [
        "arts/base"
      ],
      "update_call_sites": [
        "src/php",
        "src/wordpress-plugin"
      ],
      "delete_vendor_packages": false,
      "exclude_from_copy": {
        "file_patterns": [
          "/^tests\\//",
          "/phpcs\\.xml/",
          "/phpstan/",
          "/\\.github/",
          "/\\.gitignore/",
          "/composer\\.lock/"
        ]
      }
    }
  }
}
