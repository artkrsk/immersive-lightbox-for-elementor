{
  "name": "arts/immersive-lightbox",
  "description": "A PhotoSwipe lightbox that replaces Elementor's native one: cinematic transitions, mousemove explore pan, video galleries, any link as a trigger.",
  "version": "1.0.0",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Artem Semkin",
      "email": "me@artemsemkin.com",
      "homepage": "https://artemsemkin.com"
    }
  ],
  "homepage": "https://artemsemkin.com/plugins/immersive-lightbox-for-elementor/",
  "wordpress": {
    "Requires at least": "6.2",
    "Tested up to": "7.1",
    "Requires PHP": "8.0"
  },
  "plugin": {
    "Plugin Name": "Arts Immersive Lightbox for Elementor",
    "Plugin URI": "https://artemsemkin.com/plugins/immersive-lightbox-for-elementor/",
    "Description": "A PhotoSwipe lightbox that replaces Elementor's native one: cinematic transitions, mousemove explore pan, video galleries, any link as a trigger.",
    "Text Domain": "immersive-lightbox-for-elementor",
    "License": "GPLv3",
    "License URI": "https://www.gnu.org/licenses/gpl-3.0"
  },
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "arts/elementor-stubs": "^4.0",
    "arts/wp-plugin-standards": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Arts\\ImmersiveLightbox\\": "src/php/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G",
    "pre-autoload-dump": [
      "@php -r \"is_dir('vendor-prefixed') || mkdir('vendor-prefixed');\""
    ]
  }
}
