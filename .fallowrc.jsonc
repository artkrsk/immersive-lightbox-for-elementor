{
  // Entry points beyond auto-detection, mirroring knip.json:
  // - global.d.ts: ambient window contract (TGateBoot is consumed there)
  // - project.config.js + build/**: the esbuild release harness — its deps
  //   (archiver, chokidar) and config are reachable only through these.
  "entry": [
    "src/ts/boot.ts",
    "src/ts/gate.ts",
    "src/ts/global.d.ts",
    "project.config.js",
    "build/**/*.js"
  ],
  // The build/ directory sits outside fallow's analyzable set (default build
  // ignore), so its imports are never traversed: these two are consumed by
  // build/sass.js, build/sync.js and build/package.js (the release harness).
  "ignoreDependencies": ["archiver", "chokidar"],
  // Same semantics knip runs with: a type consumed within its own module
  // is not dead surface.
  "ignoreExportsUsedInFile": true,
  "duplicates": {
    // Test fixtures rhyme by design (same DOM scaffold, different assertion);
    // the fork keeps upstream's shapes (repeated axis math is upstream code).
    "ignore": ["tests/**", "src/ts/photoswipe/**"]
  },
  "health": {
    // Complexity gates apply to shipped engine code, not test bodies. The
    // fork keeps upstream's function shapes (correctZoomPan and friends are
    // phase-2 first-class work, verified on-device) — but its DEAD CODE is
    // now analyzed like everything else (a lightbox/-sized find pays for
    // this line).
    "ignore": ["tests/**", "src/ts/photoswipe/**"],
    // CRAP is a coverage-policy metric (cyclomatic² × (1-coverage)³), not a
    // complexity one. This engine is playground-first by design — rAF
    // choreography and gesture feel are verified in the browser harness
    // (see CLAUDE.md), and pure/detachable logic gets unit tests instead.
    // The real complexity gates (maxCyclomatic 20, maxCognitive 15) stay
    // at their defaults.
    "maxCrap": 999
  }
}
