{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The vendored PhotoSwipe fork is plain JS with JSDoc types: allowJs lets
    // tsc infer its types for our imports; checkJs stays off so upstream code
    // is not held to our strict rules.
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@engine": ["./src/ts/index.ts"],
      "@styles/*": ["./src/styles/*"],
      "@ts/*": ["./src/ts/*"]
    }
  },
  "include": ["src/ts/**/*", "tests/**/*", "vitest.config.ts"]
}
