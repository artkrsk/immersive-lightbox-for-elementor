{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "extends": ["@arts/wp-plugin-tooling/biome"],
  "files": {
    "includes": [
      "src/ts/**",
      "tests/**",
      "docs/.vitepress/**/*.ts",
      "docs/demos/**/*.ts",
      "project.config.js",
      "vitest.config.ts",
      "biome.json",
      "knip.json",
      ".fallowrc.jsonc"
    ]
  },
  "overrides": [
    {
      "includes": ["src/ts/photoswipe/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off",
            "useIterableCallbackReturn": "off",
            "noConfusingVoidType": "off"
          },
          "style": { "noNonNullAssertion": "off", "useTemplate": "off" },
          "complexity": { "noBannedTypes": "off", "useOptionalChain": "off" }
        }
      }
    }
  ]
}
