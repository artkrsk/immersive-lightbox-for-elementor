# Machine-specific dev sync target for `pnpm dev:plugin`. Two shapes are in use:
# a consumer theme's Mutagen staging dir, e.g.
# DEV_TARGET=/Users/art/Projects/Themes/Velum/DEV/wp-sync/wp-content/plugins/immersive-lightbox-for-elementor
# or the plugin directory of a Local site, for stock-theme conditions, e.g.
# DEV_TARGET=/Users/art/Local Sites/fluid-ds/app/public/wp-content/plugins/immersive-lightbox-for-elementor
